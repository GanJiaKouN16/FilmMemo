<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Start Lightmeter Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start_lightmeter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="开始测光"
            android:textSize="16sp"
            app:icon="@android:drawable/ic_menu_camera"
            app:backgroundTint="@color/accent" />

        <!-- Exposure Values Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="曝光数值"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <!-- ISO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="ISO:"
                        android:textSize="14sp" />

                    <SeekBar
                        android:id="@+id/seekbar_iso"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:enabled="false" />

                    <TextView
                        android:id="@+id/tv_iso_value"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="400"
                        android:textSize="14sp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Aperture -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="光圈:"
                        android:textSize="14sp" />

                    <SeekBar
                        android:id="@+id/seekbar_aperture"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tv_aperture_value"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="2.8"
                        android:textSize="14sp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Shutter Speed -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="快门:"
                        android:textSize="14sp" />

                    <SeekBar
                        android:id="@+id/seekbar_shutter"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tv_shutter_value"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="1/125"
                        android:textSize="14sp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- EV Value -->
                <TextView
                    android:id="@+id/tv_ev_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="EV值: 12.0"
                    android:textSize="16sp"
                    android:textColor="@color/accent" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Flash Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="闪光灯"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_flash"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_flash_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Flash Aperture -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="光圈:"
                            android:textSize="14sp" />

                        <SeekBar
                            android:id="@+id/seekbar_flash_aperture"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tv_flash_aperture_value"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="2.8"
                            android:textSize="14sp"
                            android:gravity="center" />
                    </LinearLayout>

                    <!-- Flash Distance -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="距离:"
                            android:textSize="14sp" />

                        <SeekBar
                            android:id="@+id/seekbar_flash_distance"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tv_flash_distance_value"
                            android:layout_width="60dp"
                            android:layout_height="wrap_content"
                            android:text="2.0米"
                            android:textSize="14sp"
                            android:gravity="center" />
                    </LinearLayout>

                    <!-- GN Value -->
                    <TextView
                        android:id="@+id/tv_gn_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="闪光指数 GN: 5.6"
                        android:textSize="16sp"
                        android:textColor="@color/accent" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
